{
  "name": "betterfy",
  "productName": "Betterfy",
  "version": "0.2.0",
  "private": true,
  "description": "Ein eigener, minimalistischer Desktop-Client für Spotify",
  "author": "zSymon",
  "homepage": "https://github.com/zSymon/betterfy",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c magenta,green \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/electron.cjs\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && node scripts/electron.cjs",
    "typecheck": "tsc --noEmit",
    "sign": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "de.zsymon.betterfy",
    "productName": "Betterfy",
    "electronVersion": "45.2.1",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "afterSign": "scripts/after-sign.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Betterfy-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Betterfy",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
